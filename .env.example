# Copiá este archivo como .env.local y completá la IP de la PC donde corre el backend.
# En el celular "localhost" es el propio teléfono, por eso hay que usar la IP de la PC
# (en Windows: comando ipconfig → "Dirección IPv4" del adaptador Wi-Fi).
# Con el stack Docker de GalacticApp, la API se expone en el puerto 8080 bajo /api.
EXPO_PUBLIC_API_URL=http://192.168.0.10:8080/api
