{
  "expo": {
    "name": "GalacticApp-demo",
    "slug": "galacticapp-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.unahur.galacticapp.demo",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "GalacticApp usa la cámara para sacar fotos del vehículo y del trabajo realizado.",
          "photosPermission": "GalacticApp accede a tus fotos para adjuntarlas a reclamos y controles del vehículo."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GalacticApp comparte tu ubicación con tu coordinador mientras tu jornada está activa.",
          "locationAlwaysAndWhenInUsePermission": "GalacticApp registra el recorrido de tu jornada, aunque el celular esté bloqueado. Solo se usa mientras la jornada está activa.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ]
    ],
    "scheme": "galacticapp",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b339c585-33cf-440b-891e-592e47b98354"
      }
    },
    "owner": "sebabranda77"
  }
}
