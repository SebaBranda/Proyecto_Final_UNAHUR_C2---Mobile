{
  "expo": {
    "name": "GalacticApp",
    "slug": "galacticapp-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "GalacticApp usa la cámara para sacar fotos del vehículo y del trabajo realizado.",
          "photosPermission": "GalacticApp accede a tus fotos para adjuntarlas a reclamos y controles del vehículo."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GalacticApp comparte tu ubicación con tu coordinador mientras tu jornada está activa."
        }
      ]
    ],
    "scheme": "galacticapp"
  }
}
